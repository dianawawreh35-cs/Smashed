# Copy to .env next to the compose files and fill in every value.
# .env is git-ignored; .env.example is not. Never commit real secrets.
# The API refuses to start while JWT_SECRET or SIP_SECRET_KEY still says
# change-me (F-13): these examples are in the repository for anyone to read.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- API ------------------------------------------------------------------
# Signs the tokens the Agent App and the supervisor app hold. At least 32
# characters of random data, e.g. `openssl rand -base64 48`. Changing it signs
# every agent and supervisor out.
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts the agents' SIP secrets and the server's own extension's password in
# the database, so a database dump does not hand over the extensions'
# passwords. `openssl rand -base64 32`.
# Losing it means re-entering the extensions in the supervisor app — no call
# data is lost.
SIP_SECRET_KEY=change-me-to-a-long-random-string

# --- PBX (Issabel / Asterisk, hosted by the telephony provider) -----------
# Nothing to fill in here. The PBX address is the `pbx.host` setting in the
# supervisor app (runbook step 7). The agents' calls run on their laptops, but
# the server does make SIP calls of its own, from its own extension: the
# blacklist and queue feature codes, the agents' phone states and listening in
# (S-46, S-60, S-61, S-62). That extension and its password are entered in the
# supervisor app too (runbook step 8.3), not here. The AMI login and the
# call-back extension that used to be here were removed on 19 September 2026.

# --- POS customer lookup (A-67) -------------------------------------------
# The bearer token the restaurant's POS issued for its CustLookup endpoint.
# With it, the server asks the POS every few minutes (set on the supervisor's settings screen, five by default) about recent callers
# nobody has on file, and makes or fills in their contacts. Leave it blank to
# keep that off.
POS_LOOKUP_TOKEN=

# How long recordings are kept is not here either: it is the
# recording.retention_days setting in the supervisor app, 90 days by default
# (A-33). RECORDING_RETENTION_DAYS, which used to be here, was read by nothing.

# --- Locale ---------------------------------------------------------------
TZ=Asia/Hebron
