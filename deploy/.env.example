# Copy to .env next to the compose files and fill in every value.
# .env is git-ignored; .env.example is not. Never commit real secrets.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- API ------------------------------------------------------------------
# Signs the tokens the Agent App and the supervisor app hold. At least 32
# characters of random data, e.g. `openssl rand -base64 48`. Changing it signs
# every agent and supervisor out.
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts the agents' SIP secrets in the database, so a database dump does not
# hand over the extensions' passwords. `openssl rand -base64 32`.
# Losing it means re-entering the extensions in the supervisor app — no call
# data is lost.
SIP_SECRET_KEY=change-me-to-a-long-random-string

# LAN address the server is reachable on (used for SIP contact / callbacks).
SERVER_IP=192.168.1.100

# --- PBX (Issabel / Asterisk, hosted by the telephony provider) -----------
# Reached over the VPN, so this is the address the PBX has on the VPN - not an
# address on the restaurant LAN. The server needs its own VPN connection.
PBX_HOST=10.8.0.1
AMI_USER=callcenter
AMI_PASSWORD=change-me

# Extension the server uses to place callbacks, and its SIP secret.
CALLBACK_EXT=199
CALLBACK_EXT_PASSWORD=change-me

# --- Media ----------------------------------------------------------------
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# --- Retention ------------------------------------------------------------
# Call recordings older than this many days are deleted by the retention job.
RECORDING_RETENTION_DAYS=90

# --- Locale ---------------------------------------------------------------
TZ=Asia/Hebron
