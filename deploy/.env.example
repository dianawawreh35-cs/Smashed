# Copy to .env next to the compose files and fill in every value.
# .env is git-ignored; .env.example is not. Never commit real secrets.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- API ------------------------------------------------------------------
# At least 32 characters of random data, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string

# LAN address the server is reachable on (used for SIP contact / callbacks).
SERVER_IP=192.168.1.10

# --- PBX (Asterisk) -------------------------------------------------------
PBX_IP=192.168.1.20
AMI_USER=callcenter
AMI_PASSWORD=change-me

# Extension the server uses to place callbacks, and its SIP secret.
CALLBACK_EXT=199
CALLBACK_EXT_PASSWORD=change-me

# --- Media ----------------------------------------------------------------
RTP_PORT_MIN=10000
RTP_PORT_MAX=10100

# --- Retention ------------------------------------------------------------
# Call recordings older than this many days are deleted by the retention job.
RECORDING_RETENTION_DAYS=90

# --- Locale ---------------------------------------------------------------
TZ=Asia/Hebron
