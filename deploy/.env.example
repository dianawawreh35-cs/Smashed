# Copy to .env next to the compose files and fill in every value.
# .env is git-ignored; .env.example is not. Never commit real secrets.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- API ------------------------------------------------------------------
# Signs the tokens the Agent App and the supervisor app hold. At least 32
# characters of random data, e.g. `openssl rand -base64 48`. Changing it signs
# every agent and supervisor out.
JWT_SECRET=change-me-to-a-long-random-string

# Encrypts the agents' SIP secrets in the database, so a database dump does not
# hand over the extensions' passwords. `openssl rand -base64 32`.
# Losing it means re-entering the extensions in the supervisor app — no call
# data is lost.
SIP_SECRET_KEY=change-me-to-a-long-random-string

# --- PBX (Issabel / Asterisk, hosted by the telephony provider) -----------
# Nothing to fill in here. The PBX address is the `pbx.host` setting in the
# supervisor app (runbook step 7), and the server makes no SIP or audio
# connection of its own: the softphone runs on each agent's laptop. The AMI login
# and the call-back extension that used to be here were removed on 19 September
# 2026. AMI needs an inbound port the PBX doesn't have, and the call-back
# extension (S-56) was dropped.

# --- POS customer lookup (A-67) -------------------------------------------
# The bearer token the restaurant's POS issued for its CustLookup endpoint.
# With it, the server asks the POS every few minutes (set on the supervisor's settings screen, five by default) about recent callers
# nobody has on file, and makes or fills in their contacts. Leave it blank to
# keep that off.
POS_LOOKUP_TOKEN=

# --- Retention ------------------------------------------------------------
# Call recordings older than this many days are deleted by the retention job.
RECORDING_RETENTION_DAYS=90

# --- Locale ---------------------------------------------------------------
TZ=Asia/Hebron
