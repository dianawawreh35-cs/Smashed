<Application x:Class="CallCenter.AgentApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <!-- The main window's X ends the app (A-05, N-05; Dia, 2 Oct). The default,
       OnLastWindowClose, never fired: the ringing pop-up is built at start-up
       and only ever hidden (A-10), so it was always a window left open, and
       closing the main window left the app running with none, still signed
       in and still taking calls, until Task Manager ended it. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- The colours: dark here, and ThemeService puts the agent's choice in
             this place at start-up and when they switch (A-90). First, so
             everything after it can find them. -->
        <ResourceDictionary Source="Themes/Dark.xaml" />
        <!-- Typography and the control styles. Keyless styles in there
             apply by type, so views pick them up without being rewritten. -->
        <ResourceDictionary Source="Theme.xaml" />
        <!-- The converters live in there too, above the styles that use
             them: a StaticResource cannot see a resource declared after the
             merge, which crashed the classification form. -->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
