<Application x:Class="CallCenter.AgentApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CallCenter.AgentApp.Views">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Colours, typography and the control styles. Keyless styles in there
             apply by type, so views pick them up without being rewritten. -->
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <views:InverseBoolConverter x:Key="InverseBool" />
      <views:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
      <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
