<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10, not 8: SIPSorceryMedia.Windows ships only net10.0-windows from
         10.0.5 onwards, and the 8.x line carries GHSA-28gm-jrmw-xx93 in the RTP
         path that carries call audio. .NET 8 also leaves support in November
         2026. The rest of the solution stays on net8.0 - a net10 app references
         a net8.0 library without trouble. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>CallCenter.AgentApp</RootNamespace>
    <AssemblyName>CallCenter.AgentApp</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- <ApplicationIcon>Assets\app.ico</ApplicationIcon> -->
    <!-- placeholder: drop app.ico into Assets\ and uncomment the line above -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="SIPSorcery" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="SIPSorceryMedia.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CallCenter.Shared\CallCenter.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The interface labels, one file per language (A-80). Read at startup
         from i18n\ next to the executable, so a wording fix needs no rebuild. -->
    <None Update="i18n\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
