<Window x:Class="CallCenter.AgentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
        Title="{Binding Localizer[app.title]}"
        Icon="/Assets/app.ico"
        Height="740" Width="1180"
        MinHeight="560" MinWidth="1024"
        FlowDirection="{Binding Localizer.FlowDirection}"
        FontFamily="{StaticResource UiFont}"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

  <!--
    The window is only a frame: the login screen until an agent signs in, then
    the signed-in shell. The phone's status used to live in a bar along the
    bottom; it now sits in the rail, where the agent is already looking.
  -->
  <DockPanel>

    <!-- A-82: a newer version is ready. The agent chooses when: the button is
         off during a call, since updating closes the app and the phone. -->
    <Border DockPanel.Dock="Top"
            Visibility="{Binding Updater.IsOffered, Converter={StaticResource BoolToVisibility}}"
            Background="{StaticResource AccentDim}"
            BorderBrush="{StaticResource Accent}"
            BorderThickness="0,0,0,2"
            Padding="16,8">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource PrimaryButton}"
                MinWidth="120"
                VerticalAlignment="Center"
                Content="{Binding Localizer[update.now]}"
                Command="{Binding Updater.UpdateNowCommand}" />
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Updater.Headline}"
                     Foreground="{StaticResource Text}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Updater.Status}"
                     Style="{StaticResource Subtle}"
                     FontSize="11"
                     Margin="0,2,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- F-02: something went wrong and the app carried on. A line, not a
         message box, so it never sits over the pop-up during a call. -->
    <Border x:Name="NoticeBar"
            DockPanel.Dock="Top"
            Visibility="Collapsed"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Warning}"
            BorderThickness="0,0,0,2"
            Padding="16,8">
      <DockPanel>
        <Button x:Name="NoticeDismiss"
                DockPanel.Dock="Right"
                Style="{StaticResource GhostButton}"
                Content="{Binding Localizer[app.dismiss]}"
                Click="OnDismissNotice" />
        <local:SelectableText x:Name="NoticeText"
                              Foreground="{StaticResource Warning}"
                              TextWrapping="Wrap"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <ContentControl x:Name="ShellContent" />
  </DockPanel>
</Window>
