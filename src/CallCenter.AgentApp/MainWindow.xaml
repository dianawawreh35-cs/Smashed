<Window x:Class="CallCenter.AgentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
        Title="{Binding Localizer[app.title]}"
        Icon="/Assets/app.ico"
        Height="740" Width="1180"
        MinHeight="560" MinWidth="1024"
        FlowDirection="{Binding Localizer.FlowDirection}"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

  <!--
    The window is only a frame: the login screen until an agent signs in, then
    the signed-in shell. The phone's status used to live in a bar along the
    bottom; it now sits in the rail, where the agent is already looking.
  -->
  <DockPanel>

    <!-- A-19: the call, across the top of every screen, while the pop-up has
         one: ringing, connected, or over with its form still to do. The pop-up
         goes behind the main window as soon as the agent clicks here, or into
         a website; this is how they find it again. A double-click anywhere on
         it brings the pop-up back, and the call's buttons are here too. Top of
         the stack: a call outranks an update and a notice. -->
    <Border DockPanel.Dock="Top"
            Visibility="{Binding Call.IsOnScreen, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource SuccessDim}"
            BorderBrush="{DynamicResource Success}"
            BorderThickness="0,0,0,2"
            Padding="16,6"
            Cursor="Hand"
            ToolTip="{Binding Localizer[call.bannerHint]}"
            MouseLeftButtonDown="OnCallBannerMouseDown">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Arrow">
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding Call.OffersAnswer, Converter={StaticResource BoolToVisibility}}">
            <Button Content="{Binding Localizer[call.answer]}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,5"
                    MinWidth="90"
                    Command="{Binding Call.AnswerCommand}"
                    ToolTip="{x:Static local:CallShortcuts.Answer}" />
            <Button Content="{Binding Localizer[call.reject]}"
                    Style="{StaticResource DangerButton}"
                    Padding="14,5"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Command="{Binding Call.RejectCommand}"
                    ToolTip="{x:Static local:CallShortcuts.Reject}" />
          </StackPanel>
          <Button Content="{Binding Localizer[call.cancel]}"
                  Style="{StaticResource DangerButton}"
                  Padding="14,5"
                  MinWidth="90"
                  Visibility="{Binding Call.IsDialling, Converter={StaticResource BoolToVisibility}}"
                  Command="{Binding Call.HangUpCommand}"
                  ToolTip="{x:Static local:CallShortcuts.HangUp}" />
          <StackPanel Orientation="Horizontal"
                      Visibility="{Binding Call.IsConnected, Converter={StaticResource BoolToVisibility}}">
            <Button Content="{Binding Call.MuteLabel}"
                    Style="{StaticResource GhostButton}"
                    Padding="12,5"
                    MinWidth="80"
                    Command="{Binding Call.ToggleMuteCommand}"
                    ToolTip="{x:Static local:CallShortcuts.Mute}" />
            <Button Content="{Binding Call.HoldLabel}"
                    Style="{StaticResource GhostButton}"
                    Padding="12,5"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    Command="{Binding Call.ToggleHoldCommand}"
                    ToolTip="{x:Static local:CallShortcuts.Hold}" />
            <Button Content="{Binding Localizer[call.hangUp]}"
                    Style="{StaticResource DangerButton}"
                    Padding="14,5"
                    MinWidth="100"
                    Margin="8,0,0,0"
                    Command="{Binding Call.HangUpCommand}"
                    ToolTip="{x:Static local:CallShortcuts.HangUp}" />
          </StackPanel>
          <Button Content="{Binding Localizer[call.bannerOpen]}"
                  Style="{StaticResource GhostButton}"
                  Padding="12,5"
                  MinWidth="70"
                  Margin="8,0,0,0"
                  Command="{Binding Call.OpenCommand}"
                  ToolTip="{Binding Localizer[call.bannerHint]}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Call.BannerStatus}"
                     Foreground="{DynamicResource Text}"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Call.Number}"
                     FontFamily="{StaticResource MonoFont}"
                     Foreground="{DynamicResource Text}"
                     FlowDirection="LeftToRight"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center" />
          <TextBlock Text="{Binding Call.Caller.Name}"
                     Foreground="{DynamicResource Text}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     MaxWidth="260"
                     Visibility="{Binding Call.Caller.HasName, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Call.Duration}"
                     FontFamily="{StaticResource MonoFont}"
                     Foreground="{DynamicResource TextMuted}"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding Call.IsConnected, Converter={StaticResource BoolToVisibility}}" />
          <!-- A-24: a customer still waiting on hold behind this call. -->
          <TextBlock Foreground="{DynamicResource Warning}"
                     FontWeight="SemiBold"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Visibility="{Binding Call.HasHeldCall, Converter={StaticResource BoolToVisibility}}">
            <Run Text="{Binding Localizer[call.heldCall], Mode=OneWay}" />
            <Run Text="{Binding Call.HeldNumber, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- A-82: a newer version is ready. The agent chooses when: the button is
         off during a call, since updating closes the app and the phone. -->
    <Border DockPanel.Dock="Top"
            Visibility="{Binding Updater.IsOffered, Converter={StaticResource BoolToVisibility}}"
            Background="{DynamicResource AccentDim}"
            BorderBrush="{DynamicResource Accent}"
            BorderThickness="0,0,0,2"
            Padding="16,8">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Style="{StaticResource PrimaryButton}"
                MinWidth="120"
                VerticalAlignment="Center"
                Content="{Binding Localizer[update.now]}"
                Command="{Binding Updater.UpdateNowCommand}" />
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding Updater.Headline}"
                     Foreground="{DynamicResource Text}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding Updater.Status}"
                     Style="{StaticResource Subtle}"
                     FontSize="11"
                     Margin="0,2,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- F-02: something went wrong and the app carried on. A line, not a
         message box, so it never sits over the pop-up during a call. -->
    <Border x:Name="NoticeBar"
            DockPanel.Dock="Top"
            Visibility="Collapsed"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Warning}"
            BorderThickness="0,0,0,2"
            Padding="16,8">
      <DockPanel>
        <Button x:Name="NoticeDismiss"
                DockPanel.Dock="Right"
                Style="{StaticResource GhostButton}"
                Content="{Binding Localizer[app.dismiss]}"
                Click="OnDismissNotice" />
        <local:SelectableText x:Name="NoticeText"
                              Foreground="{DynamicResource Warning}"
                              TextWrapping="Wrap"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <ContentControl x:Name="ShellContent" />
  </DockPanel>
</Window>
