<Window x:Class="CallCenter.AgentApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مركز الاتصال - Call Center Agent"
        Height="720" Width="1120"
        MinHeight="480" MinWidth="800"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource StatusBarBrush}"
            Padding="12,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Ellipse Width="10" Height="10"
                   Fill="#EF4444"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
          <TextBlock x:Name="ConnectionStatusText"
                     Text="Not connected"
                     Foreground="{StaticResource StatusBarTextBrush}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   Text="v0.1.0"
                   Foreground="{StaticResource StatusBarTextBrush}"
                   Opacity="0.6"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Shell content: views are added with their features -->
    <Grid>
      <TextBlock Text="Call Center Agent"
                 FontSize="22"
                 Opacity="0.35"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>

  </DockPanel>
</Window>
