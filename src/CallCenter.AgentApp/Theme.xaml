<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:vm="clr-namespace:CallCenter.AgentApp.ViewModels"
                    xmlns:views="clr-namespace:CallCenter.AgentApp.Views">

  <!-- ===== Converters ==============================================
       Declared here rather than in App.xaml, and the reason is a crash: the
       classification field templates below use BoolToVisibility, and a merged
       dictionary is parsed before the resources that follow the merge. A
       StaticResource can only see what has already been declared, so a
       converter defined after the merge is invisible to everything inside it.

       Keeping them at the top of the same file as the styles that use them
       removes the ordering question entirely. -->
  <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
  <views:InverseBoolConverter x:Key="InverseBool" />
  <views:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
  <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

  <!--
    The Agent App's look, following the CallPoc proof of concept: a dark shell,
    one blue accent, and cards on a near-black canvas.

    #4F8CFF started as a placeholder carried over from that proof of concept.
    On 2026-09-20 the client chose to keep it, so it is the brand colour rather
    than a stand-in. The supervisor app's brand.400/500/600 is the same value —
    change both together or the two apps stop matching.

    Dark suits the job. An agent has this on screen for an eight-hour shift,
    often in a back room, and a white full-screen window for that long is
    tiring. It also lets the one accent colour carry meaning - what is selected,
    what is the primary action - instead of competing with a bright background.
  -->

  <!-- ===== Palette ================================================== -->
  <Color x:Key="BgColor">#0F1115</Color>
  <Color x:Key="AccentColor">#4F8CFF</Color>

  <SolidColorBrush x:Key="Bg" Color="#0F1115" />
  <SolidColorBrush x:Key="Surface" Color="#171A21" />
  <SolidColorBrush x:Key="SurfaceAlt" Color="#1E222B" />
  <SolidColorBrush x:Key="BorderSoft" Color="#2A2F3A" />

  <SolidColorBrush x:Key="Text" Color="#E6E8EC" />
  <SolidColorBrush x:Key="TextMuted" Color="#8B93A7" />
  <SolidColorBrush x:Key="TextFaint" Color="#5E667A" />

  <SolidColorBrush x:Key="Accent" Color="#4F8CFF" />
  <SolidColorBrush x:Key="AccentHover" Color="#6BA0FF" />
  <SolidColorBrush x:Key="AccentDim" Color="#25355A" />

  <SolidColorBrush x:Key="Success" Color="#3FB950" />
  <SolidColorBrush x:Key="Warning" Color="#D29922" />
  <SolidColorBrush x:Key="Danger" Color="#F85149" />

  <CornerRadius x:Key="CornerSmall">6</CornerRadius>
  <CornerRadius x:Key="CornerLarge">10</CornerRadius>

  <!-- ===== Typography ============================================== -->
  <!--
    Cairo carries Arabic and Latin in one family. It is a Google font and may
    not be installed, so Segoe UI is named after it - it has proper Arabic
    coverage on Windows 10 and 11.
  -->
  <FontFamily x:Key="UiFont">Cairo, Tajawal, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <sys:Double x:Key="FontSizeSmall">11</sys:Double>
  <sys:Double x:Key="FontSizeBody">13</sys:Double>
  <sys:Double x:Key="FontSizeTitle">19</sys:Double>

  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="Subtle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>

  <!-- Field captions sit above their box, small and quiet. -->
  <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Margin" Value="0,14,0,5" />
  </Style>

  <!-- ===== Buttons ================================================= -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerSmall}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />

  <!-- The one action a screen is about: sign in, save, answer. -->
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Success}" />
    <Setter Property="BorderBrush" Value="{StaticResource Success}" />
    <Setter Property="Foreground" Value="#08130A" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
  </Style>

  <!-- ===== Check boxes ==============================================
       Unstyled until 2026-09-22, which meant Windows drew the label in its own
       near-black on our near-black surface: legible only by the tick beside it.
       Fifth control to fall into that hole after the contacts list, the
       DatePicker, its calendar and the ComboBox.

       Only the label is taken over. The box itself is the Windows one, which is
       a light square with a dark tick and reads perfectly well on a dark
       background — re-templating it would be a second thing to maintain for no
       gain. -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Style.Triggers>
      <!-- Auto answer while do not disturb is on, for instance: it still says
           what it is, quietly, rather than disappearing. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Text input ============================================== -->

  <!-- ===== Classification form fields ===============================
       One template per kind of question (A-40, S-40). WPF picks these by the
       type of the view model, so nothing decides what to draw with a switch:
       the supervisor's field list becomes controls on its own.

       They live here, in the application's resources, rather than in a window's.
       They started in the call pop-up, and when the call log became the second
       screen to draw the same form it could not see them - an ItemsControl with
       no template for its items falls back to printing the class name, so the
       form came out as a list of "CallCenter.AgentApp.ViewModels.TypeField...".
       A form drawn in two places belongs to neither of them. -->


    <!-- One template per kind of question. WPF picks these by the type of the
         view model, so nothing decides what to draw with a switch: the
         supervisor's field list becomes controls on its own. -->

    <DataTemplate DataType="{x:Type vm:TypeFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <ComboBox ItemsSource="{Binding Types}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BranchFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <ComboBox ItemsSource="{Binding Branches}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  DisplayMemberPath="Name"
                  Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SelectFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <ComboBox ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextAreaFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="54"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,3,0,0" />
      </StackPanel>
    </DataTemplate>

    <!-- The number stays text until it is sent: a box that fights the agent as
         they type "12." mid-thought is worse than one that says so after. -->
    <DataTemplate DataType="{x:Type vm:NumberFieldViewModel}">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label}" Style="{StaticResource Subtle}" FontSize="11" />
        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource MonoFont}"
                 Margin="0,3,0,0" />
        <TextBlock Text="{Binding Localizer[classification.notANumber]}"
                   Foreground="{StaticResource Danger}"
                   FontSize="11"
                   Margin="0,3,0,0"
                   Visibility="{Binding IsUnreadable, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CheckboxFieldViewModel}">
      <CheckBox Content="{Binding Label}"
                IsChecked="{Binding IsChecked, Mode=TwoWay}"
                Margin="0,0,0,10" />
    </DataTemplate>

  <!-- ===== ComboBox =================================================
       Unstyled until 2026-09-21, which meant Windows drew it light: a white
       list with our near-white text on it, unreadable in the classification
       form. Fourth control on this project to fall into the same hole after the
       contacts list, the DatePicker and the calendar behind it.

       Both parts are templated, because the list is a Popup with its own
       chrome and the item inside it draws its own background. Styling the box
       alone would have left the list white. -->

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome"
                  Background="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDim}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource CornerSmall}" />

            <!-- The whole box opens the list, not just an arrow at the end:
                 a supervisor or agent aiming at a 14-pixel chevron mid-call is
                 a needless bit of precision. -->
            <ToggleButton Background="Transparent"
                          BorderThickness="0"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="ContentSite"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              IsHitTestVisible="False" />

            <TextBlock x:Name="Chevron"
                       Text="&#x2304;"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="14"
                       Margin="0,0,10,3"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />

            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False">
              <Border Background="{StaticResource Surface}"
                      BorderBrush="{StaticResource BorderSoft}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource CornerSmall}"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="260"
                      Margin="0,2,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerSmall}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerSmall}">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Left rail navigation ==================================== -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="Transparent" Margin="8,2">
            <Border x:Name="Chrome"
                    CornerRadius="{StaticResource CornerSmall}"
                    Background="Transparent"
                    Padding="14,10">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <!-- The marker sits on the start edge, so it moves to the right in
                 Arabic with the rest of the layout. -->
            <Border x:Name="Bar"
                    Width="3"
                    HorizontalAlignment="Left"
                    CornerRadius="2"
                    Background="Transparent"
                    Margin="-8,6" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
              <Setter TargetName="Bar" Property="Background" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Cards and pills ========================================= -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CornerLarge}" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
  </Style>

  <!-- ===== DataGrid ================================================ -->
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource Surface}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource AccentDim}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGrid">
    <!-- Explicit, not Transparent. WPF's default DataGrid template paints its
         own surface underneath, so a transparent DataGrid still came out white
         on a dark card. Every background here is stated outright for that
         reason. -->
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="{StaticResource Surface}" />
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface}" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="RowHeight" Value="44" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
  </Style>

  <!-- ===== DatePicker ===============================================
       WPF's default DatePicker is light-themed, and a control with no style
       here falls back to it - which is exactly how the contacts list came out
       as a white block on 2026-09-17. The calendar popup is a separate control
       with its own default, so both are styled. -->

  <Style TargetType="DatePickerTextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePickerTextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DatePicker">
    <!-- DynamicResource because DarkCalendar is defined further down this file
         and StaticResource resolves in parse order. -->
    <Setter Property="CalendarStyle" Value="{DynamicResource DarkCalendar}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DatePicker">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerSmall}">
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" />

              <Button x:Name="PART_Button"
                      Grid.Column="1"
                      Width="18"
                      Margin="6,0,0,0"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource TextMuted}"
                      Content="&#x1F4C5;"
                      FontSize="11"
                      Cursor="Hand" />

              <Popup x:Name="PART_Popup"
                     Grid.Column="0"
                     AllowsTransparency="True"
                     Placement="Bottom"
                     StaysOpen="False">
                <Border Background="{StaticResource Surface}"
                        BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerSmall}"
                        Padding="4">
                  <ContentPresenter />
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Calendar =================================================
       The dropdown behind the date filters (A-50).

       Setting Foreground and Background on Calendar alone was not enough, and
       the result was a filter nobody could read. The panel that draws the month
       is a CalendarItem: an inner control with its own default template, which
       keeps Windows' light chrome whatever the Calendar around it says. So the
       day numbers were painted in our near-white text on a near-white panel,
       and the day-of-week row in a dark grey the default template writes
       itself.

       The fix is to template CalendarItem rather than set properties on it: the
       colours live inside its template, where a Setter cannot reach. Same
       lesson as the contacts list that came out white on 2026-09-17 - an
       unstyled WPF control does not inherit a dark theme, it falls back to a
       light one. -->

  <!-- The styles below are handed down explicitly rather than left implicit,
       and this is the whole reason the first attempt at theming the calendar
       did nothing. WPF's Calendar template builds its inner parts with
       Style="{TemplateBinding CalendarItemStyle}". With that property unset the
       binding resolves to null - and a Style explicitly set to null suppresses
       the implicit style that would otherwise apply. So the panel kept its
       light chrome and our near-white day numbers were painted onto it.

       The lesson generalises: when an implicit WPF style appears to be ignored,
       look for a template handing the element a null Style through a property
       like this one. -->
  <Style x:Key="DarkCalendar" TargetType="Calendar">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <!-- DynamicResource, not StaticResource: all three are defined further
         down this file, and StaticResource resolves in parse order - it would
         hand the Calendar an unset value and the dropdown would throw the
         moment it opened. -->
    <Setter Property="CalendarItemStyle" Value="{DynamicResource DarkCalendarItem}" />
    <Setter Property="CalendarDayButtonStyle" Value="{DynamicResource DarkCalendarDayButton}" />
    <Setter Property="CalendarButtonStyle" Value="{DynamicResource DarkCalendarButton}" />
  </Style>

  <!-- A Calendar dropped straight onto a view gets the same treatment. -->
  <Style TargetType="Calendar" BasedOn="{StaticResource DarkCalendar}" />

  <Style x:Key="DarkCalendarItem" TargetType="CalendarItem">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarItem">
          <ControlTemplate.Resources>
            <!-- The Su/Mo/Tu row. The default hard-codes it to a dark grey,
                 which is invisible on a dark panel. -->
            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
              <TextBlock Text="{Binding}"
                         Foreground="{StaticResource TextMuted}"
                         FontSize="11"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,4" />
            </DataTemplate>
          </ControlTemplate.Resources>

          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{StaticResource BorderSoft}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource CornerSmall}"
                  Padding="6">
            <Grid x:Name="PART_Root">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="PART_PreviousButton"
                        Grid.Column="0"
                        Content="&#x2039;"
                        Style="{StaticResource GhostButton}"
                        Padding="8,2"
                        FontSize="14" />

                <Button x:Name="PART_HeaderButton"
                        Grid.Column="1"
                        Style="{StaticResource GhostButton}"
                        Padding="8,2"
                        FontWeight="SemiBold" />

                <Button x:Name="PART_NextButton"
                        Grid.Column="2"
                        Content="&#x203A;"
                        Style="{StaticResource GhostButton}"
                        Padding="8,2"
                        FontSize="14" />
              </Grid>

              <!-- The two views the control switches between: days, and the
                   months/years reached through the header button. Both must
                   exist under these names or the calendar cannot render, and
                   CalendarItem shows and hides them itself - DisplayMode is a
                   property of the Calendar around it, not of this control, so
                   there is nothing to template here. -->
              <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              </Grid>

              <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
              </Grid>
            </Grid>
          </Border>

        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- One day in the grid. Templated rather than set, for the same reason as
       CalendarItem: the default draws its own light background. -->
  <Style x:Key="DarkCalendarDayButton" TargetType="CalendarDayButton">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarDayButton">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CornerSmall}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
            </Trigger>
            <!-- Today, and the days spilling in from the months either side.
                 Both stay legible without competing with the chosen day. -->
            <Trigger Property="IsToday" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentDim}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
            </Trigger>
            <!-- Last, so the chosen day wins over today and over hover. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A month or a year, in the view behind the header button. -->
  <Style x:Key="DarkCalendarButton" TargetType="CalendarButton">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CalendarButton">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource CornerSmall}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
            </Trigger>
            <!-- CalendarButton is a month or a year, so it has no IsSelected
                 of its own - what it knows is whether the chosen date falls
                 inside it. -->
            <Trigger Property="HasSelectedDays" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Accent}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
