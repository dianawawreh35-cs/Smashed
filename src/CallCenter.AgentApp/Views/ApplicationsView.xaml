<UserControl x:Class="CallCenter.AgentApp.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <!-- Applications: recording one conversation that came on an app (A-70).
       The agent's own list is its own tab, App logs (AppLogsView), as the
       Call log is for calls (Dia, 25 Sep). Both share one view model, so a
       message recorded here is in App logs the moment it is saved. -->
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{Binding Localizer[nav.applications]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[applications.intro]}" Style="{StaticResource Subtle}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- ===== Record a message (A-70) ===================================== -->
    <ScrollViewer Grid.Row="1"
                  Margin="0,18,0,0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Left">
        <StackPanel>
          <TextBlock Text="{Binding Localizer[applications.recordHeading]}"
                     Foreground="{StaticResource Text}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,12" />

          <!-- A-73: the channel stays selected from one message to the next. -->
          <TextBlock Text="{Binding Localizer[applications.channel]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Channels}"
                    SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                    DisplayMemberPath="Name" />

          <!-- A-73: the number box is the quick entry. Pausing after typing
               looks the customer up, as the pop-up does for a caller. -->
          <TextBlock Text="{Binding Localizer[applications.number]}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
          <TextBox x:Name="NumberBox"
                   Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                   FontFamily="{StaticResource MonoFont}"
                   FlowDirection="LeftToRight"
                   ToolTip="{Binding Localizer[applications.numberHint]}" />

          <!-- Who it is (A-10 rules, reused): found, looking, nobody on file,
               or could not check. Never blank once a number is typed. -->
          <TextBlock Text="{Binding Customer.Name}"
                     Foreground="{StaticResource Text}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"
                     Visibility="{Binding Customer.HasName, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding Customer.Address}"
                     Style="{StaticResource Subtle}"
                     TextWrapping="Wrap"
                     Margin="0,2,0,0"
                     Visibility="{Binding Customer.HasAddress, Converter={StaticResource BoolToVisibility}}" />
          <Border Background="{StaticResource Warning}"
                  CornerRadius="{StaticResource CornerSmall}"
                  Padding="8,2"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Visibility="{Binding Customer.IsVip, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Localizer[caller.vip]}" FontSize="11" FontWeight="Bold" Foreground="#1A1200" />
          </Border>
          <TextBlock Text="{Binding Customer.StatusText}"
                     Style="{StaticResource Subtle}"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Margin="0,6,0,0"
                     Visibility="{Binding Customer.HasStatus, Converter={StaticResource BoolToVisibility}}" />

          <!-- A-11: a number nobody has can be saved as a customer from here,
               with the same form the pop-up offers. A button until asked for. -->
          <Button Content="{Binding Localizer[caller.saveAsNew]}"
                  Style="{StaticResource SmallButton}"
                  HorizontalAlignment="Left"
                  Margin="0,6,0,0"
                  Command="{Binding Customer.OpenNewCustomerCommand}"
                  Visibility="{Binding Customer.CanOfferNewCustomer, Converter={StaticResource BoolToVisibility}}" />

          <StackPanel Margin="0,10,0,0"
                      Visibility="{Binding Customer.IsFormOpen, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Localizer[contacts.name]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Customer.FormName, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="OnNewCustomerNameLostFocus" />

            <!-- A matching name is a prompt to look, never an obstacle (A-63). -->
            <Border Margin="0,8,0,0"
                    Padding="10,8"
                    Background="#2A2412"
                    BorderBrush="{StaticResource Warning}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerSmall}"
                    Visibility="{Binding Customer.SameNameMessage, Converter={StaticResource NotNullToVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding Customer.SameNameMessage}" FontSize="11" Foreground="#E8C56B" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Customer.SameName}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,0,0,6">
                        <TextBlock FontSize="11" Text="{Binding Name}" Foreground="{StaticResource Text}" />
                        <Button Content="{Binding DataContext.Localizer[contacts.addToThem],
                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                Style="{StaticResource SmallButton}"
                                HorizontalAlignment="Left"
                                Margin="0,3,0,0"
                                Command="{Binding DataContext.Customer.AddToExistingCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding Localizer[contacts.address]}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
            <TextBox Text="{Binding Customer.FormAddress, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding Localizer[contacts.notes]}" Style="{StaticResource FieldLabel}" Margin="0,8,0,4" />
            <TextBox Text="{Binding Customer.FormNotes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="44" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button Content="{Binding Localizer[caller.saveCustomer]}"
                      Style="{StaticResource PrimaryButton}"
                      MinWidth="120"
                      Command="{Binding Customer.SaveNewCustomerCommand}" />
              <Button Content="{Binding Localizer[contacts.cancel]}"
                      Style="{StaticResource GhostButton}"
                      MinWidth="90"
                      Margin="10,0,0,0"
                      Command="{Binding Customer.CancelNewCustomerCommand}" />
            </StackPanel>

            <TextBlock Text="{Binding Customer.FormMessage}"
                       Foreground="{StaticResource Warning}"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding Customer.FormMessage, Converter={StaticResource NotNullToVisibility}}" />
          </StackPanel>

          <!-- When the customer wrote. Now by default; an agent may set it
               back within today, and the server refuses anything else. -->
          <TextBlock Text="{Binding Localizer[applications.time]}" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
          <TextBox Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}"
                   Width="90"
                   HorizontalAlignment="Left"
                   FontFamily="{StaticResource MonoFont}"
                   FlowDirection="LeftToRight"
                   ToolTip="{Binding Localizer[applications.timeHint]}" />

          <Border Background="{StaticResource BorderSoft}" Height="1" Margin="0,14,0,12" />

          <!-- The Applications form (A-70): the same fields a call's form has,
               designed on their own by the supervisor. Read when Record is
               pressed and sent with the message. -->
          <TextBlock Text="{Binding Localizer[applications.classifyHeading]}"
                     Foreground="{StaticResource Text}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10" />

          <TextBlock Text="{Binding FormUnavailable}"
                     Foreground="{StaticResource Warning}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     Margin="0,0,0,8"
                     Visibility="{Binding FormUnavailable, Converter={StaticResource NotNullToVisibility}}" />

          <ItemsControl ItemsSource="{Binding Classification.Fields}">
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Visibility"
                        Value="{Binding AppliesNow, Converter={StaticResource BoolToVisibility}}" />
              </Style>
            </ItemsControl.ItemContainerStyle>
          </ItemsControl>

          <TextBlock Text="{Binding Classification.Missing}"
                     Foreground="{StaticResource Warning}"
                     FontSize="11"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{Binding Localizer[applications.record]}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="140"
                    Command="{Binding RecordCommand}" />
            <Button Content="{Binding Localizer[applications.clear]}"
                    Style="{StaticResource GhostButton}"
                    MinWidth="90"
                    Margin="10,0,0,0"
                    Command="{Binding ClearFormCommand}" />
          </StackPanel>

          <!-- Recorded, or why not. A refusal keeps what was typed on screen. -->
          <TextBlock Text="{Binding RecordMessage}"
                     Foreground="{StaticResource Warning}"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Visibility="{Binding RecordFailed, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding RecordMessage}"
                     Foreground="{StaticResource Success}"
                     FontSize="11"
                     Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Visibility="{Binding RecordFailed, Converter={StaticResource InverseBoolToVisibility}}" />
        </StackPanel>
      </Border>
    </ScrollViewer>

  </Grid>
</UserControl>
