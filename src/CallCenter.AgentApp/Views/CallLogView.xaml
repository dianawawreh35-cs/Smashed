<UserControl x:Class="CallCenter.AgentApp.Views.CallLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <Grid Margin="28,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0">
      <TextBlock Text="{Binding Localizer[nav.callLog]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[callLog.intro]}" Style="{StaticResource Subtle}" />
    </StackPanel>

    <Button Grid.Row="0" Grid.Column="1"
            Content="{Binding Localizer[callLog.refresh]}"
            Style="{StaticResource PrimaryButton}"
            VerticalAlignment="Top"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
      <TextBox Width="280"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[callLog.searchHint]}" />

      <!-- A-50: filter by date. Every filter is sent to the server, so these
           search the whole history rather than the page already fetched. -->
      <TextBlock Text="{Binding Localizer[callLog.from]}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="14,0,6,0" />
      <DatePicker SelectedDate="{Binding From}" Width="120" VerticalAlignment="Center" />

      <TextBlock Text="{Binding Localizer[callLog.to]}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="10,0,6,0" />
      <DatePicker SelectedDate="{Binding To}" Width="120" VerticalAlignment="Center" />

      <!-- A-41: what the agent still owes. One tick rather than a filter menu,
           because it is the only filter that matters at the end of a shift. -->
      <CheckBox Content="{Binding Localizer[callLog.unclassifiedOnly]}"
                IsChecked="{Binding UnclassifiedOnly}"
                VerticalAlignment="Center"
                Margin="14,0,0,0" />

      <Button Content="{Binding Localizer[callLog.clearFilters]}"
              Style="{StaticResource GhostButton}"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Command="{Binding ClearFiltersCommand}"
              Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <Border Grid.Row="2" Grid.ColumnSpan="2"
            Margin="0,18,0,0"
            Style="{StaticResource Card}"
            Padding="0">
      <Grid>

        <!-- Nothing to show: say so in the middle, rather than leaving a blank
             expanse that reads as a broken screen. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasCalls, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Localizer[callLog.emptyTitle]}"
                     Foreground="{StaticResource TextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Localizer[callLog.emptyHint]}"
                     Style="{StaticResource Subtle}"
                     Foreground="{StaticResource TextFaint}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Calls}"
                  Margin="6"
                  Visibility="{Binding HasCalls, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTextColumn x:Name="WhenColumn" Width="Auto" Binding="{Binding When}"
                                FontFamily="{StaticResource MonoFont}" />
            <DataGridTextColumn x:Name="WhoColumn" Width="*" Binding="{Binding Who}" />
            <DataGridTextColumn x:Name="NumberColumn" Width="Auto" Binding="{Binding Number}"
                                FontFamily="{StaticResource MonoFont}" />
            <DataGridTextColumn x:Name="QueueColumn" Width="Auto" Binding="{Binding Queue}" />
            <DataGridTextColumn x:Name="DurationColumn" Width="Auto" Binding="{Binding Duration}"
                                FontFamily="{StaticResource MonoFont}" />
            <DataGridTextColumn x:Name="StatusColumn" Width="Auto" Binding="{Binding Status}" />

            <!-- A-41: highlighted until classified. A chip rather than a column
                 of ticks and blanks, so a glance down the list shows the work
                 left rather than the work done. -->
            <DataGridTemplateColumn Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border Padding="7,2"
                          CornerRadius="{StaticResource CornerSmall}"
                          Background="#2A2412"
                          Visibility="{Binding IsUnclassified, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding DataContext.Localizer[callLog.unclassified],
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                               FontSize="11"
                               Foreground="{StaticResource Warning}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

  </Grid>
</UserControl>
