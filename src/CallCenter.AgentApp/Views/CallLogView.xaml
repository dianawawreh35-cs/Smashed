<UserControl x:Class="CallCenter.AgentApp.Views.CallLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <UserControl.Resources>
    <!-- The seek bar for a recording (A-51). Styled here because the theme has
         no Slider, and an unstyled WPF control does not take the dark theme:
         it arrives as a pale Windows track on a dark card. -->
    <Style x:Key="SeekFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SeekRest" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SeekBar" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent" MinHeight="20">
              <Border Height="4"
                      CornerRadius="2"
                      Background="{StaticResource SurfaceAlt}"
                      VerticalAlignment="Center" />
              <Track x:Name="PART_Track" VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SeekFill}" Command="Slider.DecreaseLarge" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SeekRest}" Command="Slider.IncreaseLarge" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="12" Height="12">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{StaticResource Text}" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root" Margin="28,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <!-- The list. MinHeight, and the cap on the row below set in the
           code-behind, are what keep it on screen once a call is opened: the
           details card and the form together are taller than the window, and
           without both the list gave up all its height and vanished. -->
      <RowDefinition Height="*" MinHeight="{x:Static local:CallLogView.MinListHeight}" />
      <!-- The call chosen from the list: its details and recording (A-51),
           then its classification form or its note - never both. Scrolls
           rather than pushing the list off the screen. -->
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0">
      <TextBlock Text="{Binding Localizer[nav.callLog]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[callLog.intro]}" Style="{StaticResource Subtle}" />

      <!-- F-08: what the upload queue gave up on. Only there when something
           is; the rail button carries the same count as a badge. Closed to one
           line until asked, so it never pushes the list down for long. -->
      <Border Margin="0,12,0,0"
              Padding="12,10"
              Background="{StaticResource WarningDim}"
              BorderBrush="{StaticResource Warning}"
              BorderThickness="1"
              CornerRadius="{StaticResource CornerSmall}"
              Visibility="{Binding HasSetAside, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="{Binding SetAsideToggleLabel}"
                      Style="{StaticResource GhostButton}"
                      Command="{Binding ToggleSetAsideCommand}" />
              <Button Content="{Binding Localizer[callLog.unsent.retry]}"
                      Style="{StaticResource SmallButton}"
                      Margin="8,0,0,0"
                      Command="{Binding RetrySetAsideCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding SetAsideTitle}"
                       Foreground="{StaticResource Warning}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
          </DockPanel>

          <StackPanel Visibility="{Binding IsSetAsideOpen, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Localizer[callLog.unsent.hint]}"
                       Style="{StaticResource Subtle}"
                       Margin="0,6,0,8"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding SetAside}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="130" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding When}" Foreground="{StaticResource Text}" />
                    <TextBlock Grid.Column="1" Text="{Binding Kind}" Foreground="{StaticResource Text}" />
                    <!-- A number reads left to right in Arabic too. -->
                    <local:SelectableText Grid.Column="2"
                                          Value="{Binding Number}"
                                          FontFamily="{StaticResource MonoFont}"
                                          Foreground="{StaticResource Text}"
                                          FlowDirection="LeftToRight"
                                          HorizontalAlignment="Left" />
                    <local:SelectableText Grid.Column="3"
                                          Value="{Binding Reason}"
                                          Style="{StaticResource SelectableSubtle}"
                                          TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Button Grid.Row="0" Grid.Column="1"
            Content="{Binding Localizer[callLog.refresh]}"
            Style="{StaticResource PrimaryButton}"
            VerticalAlignment="Top"
            Command="{Binding RefreshCommand}"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

    <!-- A wrap panel, so a narrow window (1366 x 768 at 125 %) moves the tick
         box and Clear filters onto a second line instead of cutting them off
         at the edge (review, 27 Sep). -->
    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
      <TextBox Width="280"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[callLog.searchHint]}" />

      <!-- A-50: filter by date. Every filter is sent to the server, so these
           search the whole history rather than the page already fetched. -->
      <TextBlock Text="{Binding Localizer[callLog.from]}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="14,0,6,0" />
      <DatePicker SelectedDate="{Binding From}" Width="120" VerticalAlignment="Center" />

      <TextBlock Text="{Binding Localizer[callLog.to]}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="10,0,6,0" />
      <DatePicker SelectedDate="{Binding To}" Width="120" VerticalAlignment="Center" />

      <!-- A-41: what the agent still owes. One tick rather than a filter menu,
           because it is the only filter that matters at the end of a shift. -->
      <CheckBox Content="{Binding Localizer[callLog.unclassifiedOnly]}"
                IsChecked="{Binding UnclassifiedOnly}"
                VerticalAlignment="Center"
                Margin="14,0,0,0" />

      <Button Content="{Binding Localizer[callLog.clearFilters]}"
              Style="{StaticResource GhostButton}"
              Margin="10,0,0,0"
              VerticalAlignment="Center"
              Command="{Binding ClearFiltersCommand}"
              Visibility="{Binding HasFilters, Converter={StaticResource BoolToVisibility}}" />

      <local:SelectableText Value="{Binding StatusMessage}"
                            Style="{StaticResource SelectableSubtle}"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </WrapPanel>

    <Border Grid.Row="2" Grid.ColumnSpan="2"
            Margin="0,18,0,0"
            Style="{StaticResource Card}"
            Padding="0">
      <Grid>

        <!-- Nothing to show: say so in the middle, rather than leaving a blank
             expanse that reads as a broken screen. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasCalls, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Localizer[callLog.emptyTitle]}"
                     Foreground="{StaticResource TextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Localizer[callLog.emptyHint]}"
                     Style="{StaticResource Subtle}"
                     Foreground="{StaticResource TextFaint}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!--
          CanUserSortColumns is off, and that is a fix rather than a
          simplification. WPF turns every column header into a sort button by
          default, and two things make that actively wrong here:

          * Every column binds to a **formatted string** - the time is "10:44"
            or "21/09 21:00", the duration is "0:16", the result is translated.
            Sorting them sorts text, so "21/09 21:00" lands above "16:40" and a
            sort by time produces an order that is not a time order at all.

          * This grid holds **the last 100 calls, newest first**, chosen by the
            server. Re-sorting a truncated page looks like a ranking of
            everything and is a ranking of the page.

          The sort also survived a refresh, because it lives on the collection
          view rather than the collection: one click on a header, and every
          later refresh quietly dropped its rows into that old order. That is
          what "the refresh button does not work, I have to sign out and in"
          was - signing in built a new grid, which is the only thing that
          cleared it.
        -->
        <!--
          HorizontalScrollBarVisibility is Disabled here, overriding the theme's
          Auto, and that is what fixes the last column arriving cut off.

          A star-width column cannot be measured against infinite space. With
          horizontal scrolling allowed, the DataGrid's own ScrollViewer offers
          exactly that on the first layout pass, so "Customer" could not be
          resolved from the available width and the columns after it were laid
          out against a width nobody had yet. Total came out wider than the
          card, and the rightmost column - the "Not classified" chip - was the
          one pushed off the edge. Resizing the window forced a second pass with
          a real width, which is why dragging the edge appeared to repair it and
          why it was only ever wrong on startup.

          Disabled means the columns must fit what is there, so the star column
          gives up its space instead of the last column being pushed out. The
          MinWidths below keep that honest: the chip always has room for its
          longest label in either language, and Customer cannot be squeezed to
          nothing to pay for it.
        -->
        <DataGrid ItemsSource="{Binding Calls}"
                  CanUserSortColumns="False"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="6"
                  Visibility="{Binding HasCalls, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.InputBindings>
            <!-- A-41, A-51: the way back to a call. Double-click, as the
                 contacts, menu and delivery lists open their editors. Every
                 call opens its details and recording; an answered call opens
                 the classification with them, and a missed, rejected or
                 unanswered one its note. -->
            <MouseBinding MouseAction="LeftDoubleClick"
                          Command="{Binding OpenCommand}"
                          CommandParameter="{Binding SelectedItem,
                                             RelativeSource={RelativeSource AncestorType=DataGrid}}" />
          </DataGrid.InputBindings>
          <DataGrid.Resources>
            <!-- Every text cell trims with an ellipsis and carries its full
                 value in the tooltip. Without this a long name or queue simply
                 ran under the next column: the DataGrid clips, it does not
                 wrap, and nothing said the text had been cut. -->
            <Style x:Key="TrimmedCell" TargetType="TextBlock">
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A phone number reads left to right in Arabic too, or "+970 59"
                 comes out reversed (review, 27 Sep). At the start of the cell,
                 as the text beside it is. -->
            <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource TrimmedCell}">
              <Setter Property="FlowDirection" Value="LeftToRight" />
              <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
          </DataGrid.Resources>

          <!-- Column widths (A-52). Every column but Customer is bounded: a
               fixed width for the icons, Auto with a MaxWidth for the text, so
               no single long value can push the ones after it off the card.
               Customer takes what is left, and never less than its MinWidth.
               The window's MinWidth (MainWindow) is set so that the sum of
               these minimums always fits beside the navigation; the sums are
               worked out in DECISIONS.md, 24 September. -->
          <DataGrid.Columns>
            <!-- A-21: which way the call went. An arrow in, an arrow out; the
                 word is in the tooltip. Before this an answered outgoing call
                 was indistinguishable from an answered incoming one. The word is
                 also what the column copies (A-84). -->
            <DataGridTemplateColumn Width="38" MinWidth="38" MaxWidth="38"
                                    ClipboardContentBinding="{Binding DirectionLabel}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding DirectionLabel}" Background="Transparent">
                    <TextBlock Text="&#xE8D5;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsOutbound, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="&#xE8D4;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsOutbound, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn x:Name="WhenColumn" Width="Auto" MaxWidth="120" Binding="{Binding When}"
                                FontFamily="{StaticResource MonoFont}"
                                ElementStyle="{StaticResource TrimmedCell}" />
            <DataGridTextColumn x:Name="WhoColumn" Width="*" MinWidth="110" Binding="{Binding Who}"
                                ElementStyle="{StaticResource TrimmedCell}" />
            <DataGridTextColumn x:Name="NumberColumn" Width="Auto" MaxWidth="140" Binding="{Binding Number}"
                                FontFamily="{StaticResource MonoFont}"
                                ElementStyle="{StaticResource NumberCell}" />
            <DataGridTextColumn x:Name="QueueColumn" Width="Auto" MaxWidth="120" Binding="{Binding Queue}"
                                ElementStyle="{StaticResource TrimmedCell}" />
            <DataGridTextColumn x:Name="DurationColumn" Width="Auto" MaxWidth="90" Binding="{Binding Duration}"
                                FontFamily="{StaticResource MonoFont}"
                                ElementStyle="{StaticResource TrimmedCell}" />
            <DataGridTextColumn x:Name="StatusColumn" Width="Auto" MaxWidth="120" Binding="{Binding Status}"
                                ElementStyle="{StaticResource TrimmedCell}" />

            <!-- A-50: which calls have audio. A speaker for a recording that can
                 be played, a muted one for a recording retention has removed
                 (A-33), and nothing for a call never recorded - so an old call
                 does not read as a recording that failed. MinWidth for the
                 same reason as the chip column below. -->
            <DataGridTemplateColumn Width="38" MinWidth="38" MaxWidth="38">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding RecordingHint}" Background="Transparent">
                    <TextBlock Text="&#xE767;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasRecording, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="&#xE74F;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{StaticResource TextFaint}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding RecordingExpired, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <!-- A-41: highlighted until classified. A chip rather than a column
                 of ticks and blanks, so a glance down the list shows the work
                 left rather than the work done. It copies the note, the one
                 text in it an agent would want elsewhere (A-84). -->
            <DataGridTemplateColumn Width="Auto" MinWidth="110" MaxWidth="200"
                                    ClipboardContentBinding="{Binding Notes}">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Grid>
                    <Border Padding="7,2"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="{StaticResource WarningDim}"
                            Visibility="{Binding IsUnclassified, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding DataContext.Localizer[callLog.unclassified],
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                 FontSize="11"
                                 Foreground="{StaticResource Warning}" />
                    </Border>

                    <!-- A missed, rejected or unanswered call's note, trimmed to fit; the
                         whole of it is in the tooltip. -->
                    <TextBlock Text="{Binding Notes}"
                               ToolTip="{Binding Notes}"
                               MaxWidth="176"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

    <ScrollViewer x:Name="OpenCall"
                  Grid.Row="3" Grid.ColumnSpan="2"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

    <!-- A-51: the call chosen from the list - what it was, and its recording.
         Above the form rather than instead of it: the form is what a call is
         opened for most of the time. -->
    <Border Margin="0,14,0,0"
            Style="{StaticResource Card}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <local:SelectableText Value="{Binding Opened.Who}"
                                Foreground="{StaticResource Text}"
                                FontWeight="SemiBold" />
          <local:SelectableText Value="{Binding Opened.Number}"
                                FontFamily="{StaticResource MonoFont}"
                                Foreground="{StaticResource TextMuted}"
                                FlowDirection="LeftToRight"
                                Margin="10,0,0,0" />
        </StackPanel>

        <Button Grid.Column="1" Grid.RowSpan="2"
                Content="{Binding Localizer[callLog.closeCall]}"
                Style="{StaticResource GhostButton}"
                VerticalAlignment="Top"
                Command="{Binding CloseCallCommand}" />

        <!-- When, which way, how long, how it ended, through which queue. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
          <local:SelectableText Value="{Binding Opened.StartedAt}"
                                Style="{StaticResource SelectableSubtle}"
                                FontFamily="{StaticResource MonoFont}"
                                FlowDirection="LeftToRight" />
          <local:SelectableText Value="{Binding Opened.DirectionLabel}" Style="{StaticResource SelectableSubtle}" Margin="14,0,0,0" />
          <local:SelectableText Value="{Binding Opened.Duration}"
                                Style="{StaticResource SelectableSubtle}"
                                FontFamily="{StaticResource MonoFont}"
                                FlowDirection="LeftToRight"
                                Margin="14,0,0,0" />
          <local:SelectableText Value="{Binding Opened.Status}" Style="{StaticResource SelectableSubtle}" Margin="14,0,0,0" />
          <local:SelectableText Value="{Binding Opened.Queue}" Style="{StaticResource SelectableSubtle}" Margin="14,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
        <!-- The player, once the audio has arrived. -->
        <Grid Margin="0,12,0,0"
              Visibility="{Binding Player.IsPlayable, Converter={StaticResource BoolToVisibility}}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button Content="{Binding Player.PlayPauseLabel}"
                  Style="{StaticResource PrimaryButton}"
                  MinWidth="90"
                  Command="{Binding Player.PlayPauseCommand}" />

          <Grid Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Slider Style="{StaticResource SeekBar}"
                    Minimum="0"
                    Maximum="{Binding Player.DurationSeconds}"
                    Value="{Binding Player.PositionSeconds, Mode=TwoWay}"
                    LargeChange="5"
                    SmallChange="1" />

            <!-- A-51: where the call was on hold, under the bar. Inset by half
                 the thumb, which is where the track itself starts and ends. -->
            <local:HoldBand Grid.Row="1"
                            Height="4"
                            Margin="6,2,6,0"
                            Holds="{Binding Player.Holds}"
                            DurationSeconds="{Binding Player.DurationSeconds}"
                            Fill="{StaticResource Warning}"
                            Visibility="{Binding Player.HasHolds, Converter={StaticResource BoolToVisibility}}" />
          </Grid>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Said while playback is inside a hold, so the silence is not
                 mistaken for a dead line. -->
            <TextBlock Text="{Binding Localizer[callLog.recording.holdNow]}"
                       Foreground="{StaticResource Warning}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Visibility="{Binding Player.IsAtHold, Converter={StaticResource BoolToVisibility}}" />

            <!-- Digits read left to right in both languages. -->
            <TextBlock Text="{Binding Player.PositionText}"
                       FontFamily="{StaticResource MonoFont}"
                       Foreground="{StaticResource TextMuted}"
                       FlowDirection="LeftToRight"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Every hold, as times: the marks under the bar say where, this says
             exactly when. -->
        <local:SelectableText Value="{Binding Player.HoldsText}"
                              Style="{StaticResource SelectableSubtle}"
                              Foreground="{StaticResource Warning}"
                              TextWrapping="Wrap"
                              Margin="0,8,0,0"
                              Visibility="{Binding Player.HasHolds, Converter={StaticResource BoolToVisibility}}" />

        <!-- Loading, or why there is nothing to play - or, under the player,
             that it is waiting for a live call to end. -->
        <local:SelectableText Value="{Binding Player.Message}"
                              Style="{StaticResource SelectableSubtle}"
                              TextWrapping="Wrap"
                              Margin="0,10,0,0"
                              Visibility="{Binding Player.HasMessage, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- The form for a call chosen from the list above. Its own instance, so an
         incoming call cannot wipe out what is being typed here. -->
    <Border Margin="0,14,0,0"
            Style="{StaticResource Card}"
            Visibility="{Binding Classification.IsOpen, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding Localizer[classification.classifyHeading]}"
                   Foreground="{StaticResource Text}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <ItemsControl ItemsSource="{Binding Classification.Fields}">
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Visibility"
                      Value="{Binding AppliesNow, Converter={StaticResource BoolToVisibility}}" />
            </Style>
          </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="{Binding Localizer[classification.save]}"
                  Style="{StaticResource PrimaryButton}"
                  MinWidth="120"
                  Command="{Binding Classification.SaveCommand}" />
          <Button Content="{Binding Localizer[classification.skip]}"
                  Style="{StaticResource GhostButton}"
                  MinWidth="100"
                  Margin="10,0,0,0"
                  Command="{Binding SkipCallCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding Classification.Missing}"
                   Foreground="{StaticResource Warning}"
                   FontSize="11"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />

        <local:SelectableText Value="{Binding Classification.Message}"
                              Style="{StaticResource SelectableSubtle}"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- The note on a missed, rejected or unanswered call chosen from the list. These are
         never classified - nobody spoke - so the only question is why. -->
    <Border Margin="0,14,0,0"
            Style="{StaticResource Card}"
            Visibility="{Binding IsNotesOpen, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding NotesHeading}"
                   Foreground="{StaticResource Text}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12" />

        <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="70"
                 MaxLength="4000"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="{Binding Localizer[callLog.notesSave]}"
                  Style="{StaticResource PrimaryButton}"
                  MinWidth="120"
                  Command="{Binding SaveNotesCommand}" />
          <Button Content="{Binding Localizer[callLog.notesCancel]}"
                  Style="{StaticResource GhostButton}"
                  MinWidth="100"
                  Margin="10,0,0,0"
                  Command="{Binding CloseCallCommand}" />
        </StackPanel>

        <local:SelectableText Value="{Binding NotesMessage}"
                              Style="{StaticResource SelectableSubtle}"
                              Margin="0,4,0,0"
                              TextWrapping="Wrap" />
      </StackPanel>
    </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
