<UserControl x:Class="CallCenter.AgentApp.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <Grid Margin="28,24">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Page heading: what this is, and what it is for. -->
    <StackPanel Grid.Row="0" Grid.Column="0">
      <TextBlock Text="{Binding Localizer[nav.contacts]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[contacts.intro]}" Style="{StaticResource Subtle}" />
    </StackPanel>

    <Button Grid.Row="0" Grid.Column="1"
            Content="{Binding Localizer[contacts.new]}"
            Style="{StaticResource PrimaryButton}"
            VerticalAlignment="Top"
            Command="{Binding NewCommand}" />

    <!-- One box for name, address or number: the server works out which. -->
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,18,0,0">
      <TextBox Width="340"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[contacts.searchHint]}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <Button Content="{Binding Localizer[contacts.search]}"
              Margin="8,0,0,0"
              Command="{Binding SearchCommand}" />

      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <!-- Results -->
    <Border Grid.Row="2" Grid.Column="0"
            Margin="0,18,16,0"
            Style="{StaticResource Card}"
            Padding="0">
      <Grid>

        <!-- Nothing to show: say so in the middle of the space, rather than
             leaving an empty expanse that reads as a broken screen. -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Localizer[contacts.emptyTitle]}"
                     Foreground="{StaticResource TextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Localizer[contacts.emptyHint]}"
                     Style="{StaticResource Subtle}"
                     Foreground="{StaticResource TextFaint}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <DataGrid ItemsSource="{Binding Results}"
                  Margin="6"
                  Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">

          <!-- Double-click a row to open it, as well as the Edit button. On the
               row rather than on the grid: a double-click on a column header or
               the scrollbar is not a request to open anything. -->
          <DataGrid.ItemContainerStyle>
            <Style TargetType="DataGridRow">
              <EventSetter Event="MouseDoubleClick" Handler="OnContactRowDoubleClick" />
            </Style>
          </DataGrid.ItemContainerStyle>

          <DataGrid.Columns>
            <DataGridTextColumn x:Name="NameColumn" Width="*" Binding="{Binding Name}" />

            <!-- The flags, read-only (S-45). An agent must see that a caller is
                 VIP or blocked, and must not be able to change it — so this is
                 a chip, not a checkbox, and there is no editor anywhere in this
                 app. -->
            <DataGridTemplateColumn Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal"
                              ToolTip="{Binding DataContext.Localizer[contacts.flagSetBySupervisor],
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}">
                    <Border Padding="7,2"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="#3A2E12"
                            Visibility="{Binding IsVip, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding DataContext.Localizer[contacts.vip],
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                 FontSize="11"
                                 Foreground="{StaticResource Warning}" />
                    </Border>
                    <Border Padding="7,2"
                            Margin="4,0,0,0"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="#3B1618"
                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{Binding DataContext.Localizer[contacts.blocked],
                                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                 FontSize="11"
                                 Foreground="{StaticResource Danger}" />
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>

            <DataGridTextColumn x:Name="AddressColumn" Width="*" Binding="{Binding Address}" />
            <DataGridTemplateColumn Width="Auto">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Content="{Binding DataContext.Localizer[contacts.edit],
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          Style="{StaticResource SmallButton}"
                          Command="{Binding DataContext.EditCommand,
                                    RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

      </Grid>
    </Border>

    <!-- The form, only while adding or editing -->
    <Border Grid.Row="2" Grid.Column="1"
            Width="330"
            Margin="0,18,0,0"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <TextBlock Text="{Binding Localizer[contacts.name]}"
                   Style="{StaticResource FieldLabel}"
                   Margin="0,0,0,5" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" LostFocus="OnNameLostFocus" />

        <!-- A matching name is a prompt to look, never an obstacle (A-63). -->
        <Border Margin="0,10,0,0"
                Padding="10,8"
                Background="#2A2412"
                BorderBrush="{StaticResource Warning}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerSmall}"
                Visibility="{Binding SameNameMessage, Converter={StaticResource NotNullToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding SameNameMessage}" FontSize="11" Foreground="#E8C56B" />
            <ItemsControl ItemsSource="{Binding SameName}" Margin="0,6,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,6">
                    <TextBlock FontSize="11" Text="{Binding Name}" />
                    <Button Content="{Binding DataContext.Localizer[contacts.addToThem],
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Left"
                            Margin="0,3,0,0"
                            Command="{Binding DataContext.AddToExistingCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Localizer[contacts.phone]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                 FontFamily="{StaticResource MonoFont}" />

        <TextBlock Text="{Binding Localizer[contacts.address]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Address}" />

        <TextBlock Text="{Binding Localizer[contacts.deliveryNotes]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding DeliveryNotes}" />

        <TextBlock Text="{Binding Localizer[contacts.notes]}" Style="{StaticResource FieldLabel}" />
        <TextBox Height="64"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Text="{Binding Notes}" />

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <Button Content="{Binding Localizer[contacts.save]}"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding SaveCommand}" />
          <Button Content="{Binding Localizer[contacts.cancel]}"
                  Style="{StaticResource GhostButton}"
                  Margin="8,0,0,0"
                  Command="{Binding CancelCommand}" />
        </StackPanel>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
