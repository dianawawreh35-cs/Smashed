<UserControl x:Class="CallCenter.AgentApp.Views.ContactsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}">

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- One box for name, address or number: the server works out which. -->
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
      <TextBox Width="320"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[contacts.searchHint]}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
        </TextBox.InputBindings>
      </TextBox>

      <Button Content="{Binding Localizer[contacts.search]}"
              Margin="8,0,0,0"
              Command="{Binding SearchCommand}" />
    </StackPanel>

    <Button Grid.Row="0" Grid.Column="1"
            Content="{Binding Localizer[contacts.new]}"
            Style="{StaticResource PrimaryButton}"
            Command="{Binding NewCommand}" />

    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
               Text="{Binding StatusMessage}"
               Margin="0,10,0,0"
               Foreground="{StaticResource TextMuted}"
               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

    <!-- Results -->
    <ListView Grid.Row="2" Grid.Column="0"
              Margin="0,12,12,0"
              ItemsSource="{Binding Results}">
      <ListView.View>
        <GridView>
          <!-- GridViewColumn sits outside the visual tree, so its header cannot
               reach the view model by binding. The code-behind sets these, and
               re-sets them when the language changes. -->
          <GridViewColumn x:Name="NameColumn" Width="180" DisplayMemberBinding="{Binding Name}" />
          <GridViewColumn x:Name="AddressColumn" Width="220" DisplayMemberBinding="{Binding Address}" />
          <GridViewColumn Width="90">
            <GridViewColumn.CellTemplate>
              <DataTemplate>
                <Button Content="{Binding DataContext.Localizer[contacts.edit],
                                  RelativeSource={RelativeSource AncestorType=ListView}}"
                        Style="{StaticResource SmallButton}"
                        Command="{Binding DataContext.EditCommand,
                                  RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </GridViewColumn.CellTemplate>
          </GridViewColumn>
        </GridView>
      </ListView.View>
    </ListView>

    <!-- The form, only while adding or editing -->
    <Border Grid.Row="2" Grid.Column="1"
            Width="320"
            Margin="0,12,0,0"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>

        <TextBlock Text="{Binding Localizer[contacts.name]}"
                   Style="{StaticResource FieldLabel}"
                   Margin="0,0,0,4" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                 LostFocus="OnNameLostFocus" />

        <!-- A matching name is a prompt to look, never an obstacle (A-63). -->
        <Border Margin="0,8,0,0"
                Padding="8,6"
                Background="#FFFBEB"
                BorderBrush="#FCD34D"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding SameNameMessage, Converter={StaticResource NotNullToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding SameNameMessage}" FontSize="11" Foreground="#92400E" />
            <ItemsControl ItemsSource="{Binding SameName}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,2,0,0">
                    <TextBlock FontSize="11" Text="{Binding Name}" />
                    <Button Content="{Binding DataContext.Localizer[contacts.addToThem],
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SmallButton}"
                            Command="{Binding DataContext.AddToExistingCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding Localizer[contacts.phone]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Text="{Binding Localizer[contacts.address]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Address}" />

        <TextBlock Text="{Binding Localizer[contacts.deliveryNotes]}" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding DeliveryNotes}" />

        <TextBlock Text="{Binding Localizer[contacts.notes]}" Style="{StaticResource FieldLabel}" />
        <TextBox Height="60"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalContentAlignment="Top"
                 Text="{Binding Notes}" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Content="{Binding Localizer[contacts.save]}"
                  Style="{StaticResource PrimaryButton}"
                  Command="{Binding SaveCommand}" />
          <Button Content="{Binding Localizer[contacts.cancel]}"
                  Margin="8,0,0,0"
                  Command="{Binding CancelCommand}" />
        </StackPanel>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
