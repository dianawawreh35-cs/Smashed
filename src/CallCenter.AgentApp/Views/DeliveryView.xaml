<UserControl x:Class="CallCenter.AgentApp.Views.DeliveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{DynamicResource Bg}">

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{Binding Localizer[nav.delivery]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[delivery.intro]}" Style="{StaticResource Subtle}" />
    </StackPanel>

    <!-- One box, searched as it is typed: the agent is mid-call with the
         customer waiting, so nothing here should need a second action. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
      <TextBox Width="340"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[delivery.searchHint]}" />

      <local:SelectableText Value="{Binding StatusMessage}"
                            Style="{StaticResource SelectableSubtle}"
                            VerticalAlignment="Center"
                            Margin="14,0,0,0"
                            Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Margin="0,18,0,0"
            Style="{StaticResource Card}"
            Padding="0">
      <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Localizer[delivery.emptyTitle]}"
                     Foreground="{DynamicResource TextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Localizer[delivery.emptyHint]}"
                     Style="{StaticResource Subtle}"
                     Foreground="{DynamicResource TextFaint}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <!-- A list rather than a grid: three fields, and the price is the one
             the agent is reading out, so it gets its own size. -->
        <ScrollViewer Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      Margin="6">
          <ItemsControl ItemsSource="{Binding Areas}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="14,11"
                        Margin="0,0,0,6"
                        Background="{DynamicResource SurfaceAlt}"
                        CornerRadius="{StaticResource CornerSmall}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <local:SelectableText Value="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <local:SelectableText Value="{Binding BranchName}"
                                            Style="{StaticResource SelectableSubtle}"
                                            Margin="0,2,0,0" />
                    </StackPanel>

                    <local:SelectableText Grid.Column="1"
                                          Value="{Binding Price, StringFormat={}{0:0.##}}"
                                          FontFamily="{StaticResource MonoFont}"
                                          FontSize="20"
                                          Foreground="{DynamicResource Accent}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>
    </Border>

  </Grid>
</UserControl>
