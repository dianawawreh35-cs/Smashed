<UserControl x:Class="CallCenter.AgentApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}">

  <DockPanel>

    <!-- Header: who is signed in, and the way out. -->
    <Border DockPanel.Dock="Top"
            Padding="16,12"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PhoneSummary}" FontSize="12" Opacity="0.6" Margin="0,2,0,0" />

          <!-- Each extension separately: one can be registered while the other
               is refused, and the agent needs to see which (A-02). -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="{Binding Localizer[home.customerExtension]}" FontSize="11" Opacity="0.5" />
            <TextBlock Text="{Binding CustomerStatus}" FontSize="11" Margin="4,0,12,0" />
            <TextBlock Text="{Binding Localizer[home.internalExtension]}" FontSize="11" Opacity="0.5" />
            <TextBlock Text="{Binding InternalStatus}" FontSize="11" Margin="4,0,0,0" />
          </StackPanel>
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding Localizer[app.language]}"
                Margin="0,0,8,0"
                Padding="10,7"
                Cursor="Hand"
                Background="Transparent"
                BorderBrush="#D1D5DB"
                Command="{Binding ToggleLanguageCommand}" />

        <Button Grid.Column="2"
                Content="{Binding Localizer[home.signOut]}"
                Padding="14,7"
                Cursor="Hand"
                Command="{Binding SignOutCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </Grid>
    </Border>

    <!-- Replaced by the softphone, call log, contacts and app orders tabs. -->
    <Grid>
      <TextBlock Text="{Binding Localizer[app.title]}"
                 FontSize="22"
                 Opacity="0.35"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />
    </Grid>

  </DockPanel>
</UserControl>
