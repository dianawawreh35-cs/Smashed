<UserControl x:Class="CallCenter.AgentApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CallCenter.AgentApp.Views"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Rail =====================================================
         Navigation, who is signed in, and the phone's state. It sits on the
         start edge, so it moves to the right in Arabic with everything else. -->
    <Border Grid.Column="0"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="0,0,1,0">
      <!-- Folds down to a strip (Dia, 4 Oct 2026), remembered on the laptop. -->
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Width" Value="230" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding RailCollapsed}" Value="True">
              <Setter Property="Width" Value="52" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>

      <!-- Folded: the button to open it again, and what an agent must still
           see at a glance: whether calls can reach them (A-02), and whether
           they are on break. The details are in the tooltips. -->
      <StackPanel Visibility="{Binding RailCollapsed, Converter={StaticResource BoolToVisibility}}"
                  Margin="0,18,0,0">
        <Button Style="{StaticResource GhostButton}"
                Padding="8,6"
                HorizontalAlignment="Center"
                Command="{Binding ToggleRailCommand}"
                ToolTip="{Binding Localizer[home.expandRail]}">
          <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
        </Button>
        <Ellipse Width="10" Height="10"
                 Fill="{Binding StatusBrush}"
                 HorizontalAlignment="Center"
                 Margin="0,18,0,0">
          <Ellipse.ToolTip>
            <StackPanel>
              <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PhoneSummary}" />
            </StackPanel>
          </Ellipse.ToolTip>
        </Ellipse>
        <TextBlock Text="&#xE769;"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="14"
                   Foreground="{StaticResource WarningText}"
                   HorizontalAlignment="Center"
                   Margin="0,14,0,0"
                   ToolTip="{Binding BreakSinceText}"
                   Visibility="{Binding OnBreak, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>

      <!-- Scrolls when the window is too short for all of it. Without this the
           cards docked below sat over the last sections, and Menu could not be
           reached on a laptop screen. When it all fits, the content is
           stretched to the full height, so the cards still sit at the bottom. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Focusable="False"
                    Visibility="{Binding RailCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
      <DockPanel>

        <!-- Who is signed in. The first thing to check on a shared laptop (A-05).
             The fold button on the end edge. -->
        <DockPanel DockPanel.Dock="Top" Margin="20,18,10,10">
          <Button DockPanel.Dock="Right"
                  Style="{StaticResource GhostButton}"
                  Padding="8,6"
                  VerticalAlignment="Center"
                  Command="{Binding ToggleRailCommand}"
                  ToolTip="{Binding Localizer[home.collapseRail]}">
            <TextBlock Text="&#xE700;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" />
          </Button>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34"
                    CornerRadius="17"
                    Background="{StaticResource AccentDim}">
              <TextBlock Text="{Binding Initial}"
                         FontSize="15"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource Accent}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <local:SelectableText Value="{Binding DisplayName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Localizer[app.subtitle]}" Style="{StaticResource Subtle}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>

        <!-- Sign out and language, under the status card. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,16" Orientation="Horizontal">
          <Button Content="{Binding Localizer[home.signOut]}"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding SignOutCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          <Button Content="{Binding Localizer[app.language]}"
                  Style="{StaticResource GhostButton}"
                  Margin="6,0,0,0"
                  Command="{Binding ToggleLanguageCommand}" />
        </StackPanel>

        <!-- How this phone should treat an arriving call (A-18). Beside the
             sign-out row rather than buried in a settings screen: both of these
             stop the agent's phone behaving normally, so the one place that
             says what the phone is doing is where they belong. Do not disturb
             is the one an agent must be able to see at a glance and turn off
             again without hunting for it. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,12">
          <CheckBox Content="{Binding Localizer[home.doNotDisturb]}"
                    Style="{StaticResource Switch}"
                    IsChecked="{Binding DoNotDisturb, Mode=TwoWay}"
                    IsEnabled="{Binding DoNotDisturbEditable}"
                    ToolTip="{Binding Localizer[home.doNotDisturbHint]}" />
          <CheckBox Content="{Binding Localizer[home.autoAnswer]}"
                    Style="{StaticResource Switch}"
                    IsChecked="{Binding AutoAnswer, Mode=TwoWay}"
                    IsEnabled="{Binding DoNotDisturb, Converter={StaticResource InverseBool}}"
                    ToolTip="{Binding Localizer[home.autoAnswerHint]}"
                    Margin="0,10,0,0" />
        </StackPanel>

        <!-- The break (A-86). Break in turns do not disturb on, below, and holds
             it there; Break out turns it off. The time is the day's, counting
             on from the last break. Past the day's allowance it says by how
             much, in red, and Break in still works (Dia, 1 Oct 2026). -->
        <Border DockPanel.Dock="Bottom"
                Margin="14,0,14,12"
                Padding="10,8"
                CornerRadius="{StaticResource CornerSmall}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding OnBreak}" Value="True">
                  <Setter Property="Background" Value="{StaticResource WarningDim}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <!-- The buttons are compact and sit on the start edge: full width, they
               were the biggest thing in the rail (Dia, 4 Oct 2026). -->
          <StackPanel>
            <Button Content="{Binding BreakButtonText}"
                    Style="{StaticResource PrimaryButton}"
                    Padding="14,4"
                    FontSize="12"
                    Command="{Binding ToggleBreakCommand}"
                    Visibility="{Binding OnBreak, Converter={StaticResource InverseBoolToVisibility}}"
                    ToolTip="{Binding Localizer[breaks.inHint]}"
                    HorizontalAlignment="Left" />
            <Button Content="{Binding BreakButtonText}"
                    Style="{StaticResource SuccessButton}"
                    Padding="14,4"
                    FontSize="12"
                    Command="{Binding ToggleBreakCommand}"
                    Visibility="{Binding OnBreak, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="{Binding Localizer[breaks.outHint]}"
                    HorizontalAlignment="Left" />
            <TextBlock Text="{Binding BreakSinceText}"
                       Foreground="{StaticResource WarningText}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="{Binding OnBreak, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding BreakTotalText}"
                       FontSize="12"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding BreakLimitText}"
                       Style="{StaticResource Subtle}"
                       FontSize="11"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding OverLimitText}"
                       Foreground="{StaticResource DangerText}"
                       FontWeight="SemiBold"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Visibility="{Binding IsOverLimit, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
        </Border>

        <!-- The phone, always visible. An agent should never have to go looking
             for whether calls can reach them (A-02, N-04a). -->
        <Border DockPanel.Dock="Bottom"
                Margin="14,10,14,10"
                Padding="14,10"
                Background="{StaticResource SurfaceAlt}"
                CornerRadius="{StaticResource CornerSmall}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="9" Height="9"
                       Fill="{Binding StatusBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
              <TextBlock Text="{Binding StatusTitle}"
                         FontWeight="SemiBold"
                         FontSize="12"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
            <local:SelectableText Value="{Binding PhoneSummary}"
                                  Style="{StaticResource SelectableSubtle}"
                                  FontSize="11"
                                  Margin="17,4,0,0"
                                  TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Sections. The rail grows as the call log, softphone and app orders
             tabs are built. -->
        <TabControl x:Name="Nav"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="0,6,0,0">
          <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
              <StackPanel IsItemsHost="True" />
            </ControlTemplate>
          </TabControl.Template>
        </TabControl>

      </DockPanel>
      </ScrollViewer>
      </Grid>
    </Border>

    <!-- ===== Content ================================================== -->
    <ContentControl x:Name="Pane" Grid.Column="1" />

  </Grid>
</UserControl>
