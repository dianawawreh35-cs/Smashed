<UserControl x:Class="CallCenter.AgentApp.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}">

  <DockPanel>

    <!-- Header: who is signed in, and the way out. -->
    <Border DockPanel.Dock="Top"
            Padding="20,14"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TitleText}" />
          <TextBlock Text="{Binding PhoneSummary}"
                     FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{StaticResource InkMuted}"
                     Margin="0,3,0,0" />

          <!-- Whether the PBX currently knows where to send calls (A-02). -->
          <TextBlock Text="{Binding RegistrationSummary}"
                     FontSize="{StaticResource FontSizeSmall}"
                     Foreground="{StaticResource InkMuted}"
                     Margin="0,3,0,0" />
        </StackPanel>

        <Button Grid.Column="1"
                Content="{Binding Localizer[app.language]}"
                Margin="0,0,8,0"
                Command="{Binding ToggleLanguageCommand}" />

        <Button Grid.Column="2"
                Content="{Binding Localizer[home.signOut]}"
                Command="{Binding SignOutCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
      </Grid>
    </Border>

    <!-- The agent's work. The softphone, call log and app orders tabs join
         contacts here as they are built. -->
    <TabControl x:Name="Tabs" BorderThickness="0" Background="#F9FAFB" />

  </DockPanel>
</UserControl>
