<UserControl x:Class="CallCenter.AgentApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Canvas}">

  <Grid>

    <!-- Language toggle, reachable before signing in: an agent who cannot read
         the screen has to be able to change it (A-80). -->
    <Button Content="{Binding Localizer[app.language]}"
            Style="{StaticResource SmallButton}"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="16"
            Command="{Binding ToggleLanguageCommand}" />

    <Border Width="380"
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">

      <StackPanel>

        <!-- The restaurant's mark, so the app is recognisable before anyone
             has read a word of it. -->
        <Border Width="44" Height="44"
                HorizontalAlignment="Center"
                CornerRadius="10"
                Background="{StaticResource Brand}">
          <TextBlock Text="S"
                     FontSize="22"
                     FontWeight="Bold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Border>

        <TextBlock Text="{Binding Localizer[login.heading]}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,14,0,0"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding Localizer[app.subtitle]}"
                   FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource InkMuted}"
                   Margin="0,2,0,22"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding Localizer[login.username]}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <TextBox x:Name="LoginBox"
                 Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <TextBlock Text="{Binding Localizer[login.password]}" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox"
                     PasswordChanged="OnPasswordChanged"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

        <!-- Wrong password, disabled account, or the server being down: one
             place, so the agent always looks in the same spot. -->
        <Border Margin="0,16,0,0"
                Padding="12,9"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding ErrorMessage}"
                     Foreground="#B91C1C"
                     TextWrapping="Wrap" />
        </Border>

        <Button Content="{Binding Localizer[login.submit]}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,20,0,0"
                Padding="0,10"
                IsDefault="True"
                Command="{Binding SignInCommand}" />

        <TextBlock Text="{Binding Localizer[login.connecting]}"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{StaticResource InkMuted}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
