<UserControl x:Class="CallCenter.AgentApp.Views.MenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="{Binding Localizer.FlowDirection}"
             FontFamily="{StaticResource UiFont}"
             Background="{StaticResource Bg}">

  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="{Binding Localizer[nav.menu]}" Style="{StaticResource Heading}" />
      <TextBlock Text="{Binding Localizer[menu.intro]}" Style="{StaticResource Subtle}" />
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
      <TextBox Width="340"
               Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Localizer[menu.searchHint]}" />

      <TextBlock Text="{Binding StatusMessage}"
                 Style="{StaticResource Subtle}"
                 VerticalAlignment="Center"
                 Margin="14,0,0,0"
                 Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>

    <Border Grid.Row="2"
            Margin="0,18,0,0"
            Style="{StaticResource Card}"
            Padding="0">
      <Grid>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasResults, Converter={StaticResource InverseBoolToVisibility}}">
          <TextBlock Text="{Binding Localizer[menu.emptyTitle]}"
                     Foreground="{StaticResource TextMuted}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{Binding Localizer[menu.emptyHint]}"
                     Style="{StaticResource Subtle}"
                     Foreground="{StaticResource TextFaint}"
                     Margin="0,6,0,0"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}"
                      VerticalScrollBarVisibility="Auto"
                      Margin="6">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="12"
                        Margin="0,0,0,6"
                        Background="{StaticResource SurfaceAlt}"
                        CornerRadius="{StaticResource CornerSmall}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- The picture. Fixed box so the rows line up whether or
                         not an item has one; add-ons have none. -->
                    <Border Grid.Column="0"
                            Width="86"
                            Height="64"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="{StaticResource Surface}"
                            Margin="0,0,12,0">
                      <Image Source="{Binding Image}" Stretch="UniformToFill" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding CategoryName}"
                                 Style="{StaticResource Subtle}"
                                 FontSize="11"
                                 Margin="0,2,0,0" />
                      <TextBlock Text="{Binding Description}"
                                 Style="{StaticResource Subtle}"
                                 TextWrapping="Wrap"
                                 Margin="0,5,0,0"
                                 Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- Price, and the meal price under it where there is one.
                         The agent reads these out, so they get the size. -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0">
                      <TextBlock Text="{Binding PriceText}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="19"
                                 Foreground="{StaticResource Accent}"
                                 HorizontalAlignment="Right" />
                      <TextBlock Text="{Binding MealPriceText}"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="12"
                                 Foreground="{StaticResource TextMuted}"
                                 HorizontalAlignment="Right"
                                 Margin="0,3,0,0"
                                 Visibility="{Binding HasMealPrice, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>
    </Border>

  </Grid>
</UserControl>
