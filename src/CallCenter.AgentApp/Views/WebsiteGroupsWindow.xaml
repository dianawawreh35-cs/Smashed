<Window x:Class="CallCenter.AgentApp.Views.WebsiteGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Localizer[websites.groupsTitle]}"
        Icon="/Assets/app.ico"
        FlowDirection="{Binding Localizer.FlowDirection}"
        FontFamily="{StaticResource UiFont}"
        Background="{DynamicResource Bg}"
        Width="560"
        Height="560"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <!-- A-88: the agent's own groups of tabs. Not a modal dialog: a call that
       arrives while it is open has to be answerable. -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="{Binding Localizer[websites.groupsTitle]}"
                 Foreground="{DynamicResource Text}"
                 FontSize="16"
                 FontWeight="SemiBold" />
      <TextBlock Text="{Binding Localizer[websites.groupsIntro]}"
                 Style="{StaticResource Subtle}"
                 TextWrapping="Wrap"
                 Margin="0,4,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock Text="{Binding Message}"
                 Foreground="{DynamicResource Warning}"
                 FontSize="12"
                 TextWrapping="Wrap"
                 Margin="0,0,0,8"
                 Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
      <DockPanel>
        <Button DockPanel.Dock="Left"
                Style="{StaticResource GhostButton}"
                Content="{Binding Localizer[websites.addGroup]}"
                Command="{Binding AddGroupCommand}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource PrimaryButton}"
                  MinWidth="100"
                  Content="{Binding Localizer[websites.groupsSave]}"
                  Command="{Binding SaveCommand}" />
          <Button Style="{StaticResource GhostButton}"
                  MinWidth="90"
                  Margin="8,0,0,0"
                  Content="{Binding Localizer[websites.groupsCancel]}"
                  Command="{Binding CancelCommand}" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right"
                          Style="{StaticResource GhostButton}"
                          Margin="8,0,0,0"
                          Content="{Binding Editor.Localizer[websites.removeGroup]}"
                          Command="{Binding Editor.RemoveGroupCommand}"
                          CommandParameter="{Binding}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Editor.Localizer[websites.groupName]}"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                  </StackPanel>
                </DockPanel>
                <TextBlock Text="{Binding Editor.Localizer[websites.groupTabs]}"
                           Style="{StaticResource FieldLabel}"
                           Margin="0,10,0,4" />
                <ItemsControl ItemsSource="{Binding Choices}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding IsChosen}"
                                Content="{Binding Tab.Name}"
                                Margin="0,0,16,6" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The order on screen, for two tabs or more: 1 and 2 on the
                     top row, 3 and 4 below, in reading order. -->
                <StackPanel Visibility="{Binding HasOrder, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{Binding Editor.Localizer[websites.groupOrder]}"
                             Style="{StaticResource FieldLabel}"
                             Margin="0,10,0,2" />
                  <TextBlock Text="{Binding Editor.Localizer[websites.groupOrderHint]}"
                             Style="{StaticResource Subtle}"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Margin="0,0,0,6" />
                  <ItemsControl ItemsSource="{Binding Order}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource BorderSoft}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="0,0,0,4">
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Button Style="{StaticResource GhostButton}"
                                      Padding="7,3"
                                      MinWidth="0"
                                      Command="{Binding MoveUpCommand}"
                                      ToolTip="{Binding Localizer[websites.moveEarlier]}">
                                <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                              <Button Style="{StaticResource GhostButton}"
                                      Padding="7,3"
                                      MinWidth="0"
                                      Margin="2,0,0,0"
                                      Command="{Binding MoveDownCommand}"
                                      ToolTip="{Binding Localizer[websites.moveLater]}">
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                              </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding Position}"
                                       Foreground="{DynamicResource Accent}"
                                       FontWeight="SemiBold"
                                       MinWidth="20"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Tab.Name}"
                                       Foreground="{DynamicResource Text}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
