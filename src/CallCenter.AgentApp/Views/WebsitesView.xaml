<UserControl x:Class="CallCenter.AgentApp.Views.WebsitesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CallCenter.AgentApp.ViewModels">

  <UserControl.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- A small square button with one icon, for a place's bar. -->
    <!-- The icon font goes on the text inside, not on the button: the
         theme's button template sets the interface font on its content. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}" FontFamily="{StaticResource Icons}" FontSize="13" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <!-- A layout button: the chosen one is filled. -->
    <Style x:Key="LayoutButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- The bar above each place: which tab, and its controls. A click on it
         makes it the place the tab bar fills (only marked when there are two
         or four). -->
    <DataTemplate x:Key="PlaceBar" DataType="{x:Type vm:WebsitePlace}">
      <Border x:Name="Bar"
              Background="{DynamicResource Surface}"
              BorderBrush="{DynamicResource BorderSoft}"
              BorderThickness="0,0,0,1"
              Padding="6,4">
        <Border.InputBindings>
          <MouseBinding Gesture="LeftClick" Command="{Binding ActivateCommand}" />
        </Border.InputBindings>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                      Visibility="{Binding HasTab, Converter={StaticResource BoolToVisibility}}">
            <Button Style="{StaticResource IconButton}" Content="&#xE71F;"
                    Command="{Binding Tab.ZoomOutCommand}"
                    ToolTip="{Binding Screen.Localizer[websites.zoomOut]}" />
            <TextBlock Text="{Binding Tab.ZoomText}"
                       Style="{StaticResource Subtle}"
                       FontSize="11"
                       MinWidth="36"
                       TextAlignment="Center"
                       VerticalAlignment="Center" />
            <Button Style="{StaticResource IconButton}" Content="&#xE8A3;"
                    Command="{Binding Tab.ZoomInCommand}"
                    ToolTip="{Binding Screen.Localizer[websites.zoomIn]}" />
            <Button Style="{StaticResource IconButton}" Content="&#xE749;"
                    Margin="8,0,0,0"
                    Command="{Binding Tab.SavePdfCommand}"
                    ToolTip="{Binding Screen.Localizer[websites.savePdf]}" />
            <Button Style="{StaticResource IconButton}" Content="{Binding Tab.SoundGlyph}"
                    Margin="8,0,0,0"
                    Command="{Binding Tab.ToggleMuteCommand}"
                    ToolTip="{Binding Tab.MuteLabel}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <ComboBox ItemsSource="{Binding Screen.Tabs}"
                      SelectedItem="{Binding Chosen}"
                      MinWidth="150"
                      MaxWidth="220"
                      Padding="8,3"
                      MinHeight="28"
                      VerticalAlignment="Center">
              <!-- A template, not DisplayMemberPath: the theme's box shows the
                   item itself, which for a tab is its type name. -->
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:WebsiteTab}">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal"
                        Margin="4,0,0,0"
                        Visibility="{Binding HasTab, Converter={StaticResource BoolToVisibility}}">
              <Button Style="{StaticResource IconButton}" Content="&#xE72B;"
                      Command="{Binding Tab.BackCommand}"
                      IsEnabled="{Binding Tab.CanGoBack}"
                      ToolTip="{Binding Screen.Localizer[websites.back]}" />
              <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                      Command="{Binding Tab.ReloadCommand}"
                      ToolTip="{Binding Screen.Localizer[websites.reload]}" />
              <Button Style="{StaticResource IconButton}" Content="&#xE80F;"
                      Command="{Binding Tab.HomeCommand}"
                      ToolTip="{Binding Screen.Localizer[websites.home]}" />
              <!-- Another tab on the same site, "POS 2"; a copy can be closed,
                   the supervisor's own tabs cannot. -->
              <Button Style="{StaticResource IconButton}" Content="&#xE8C8;"
                      Margin="8,0,0,0"
                      Command="{Binding DuplicateCommand}"
                      ToolTip="{Binding Screen.Localizer[websites.duplicate]}" />
              <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                      Command="{Binding CloseCopyCommand}"
                      Visibility="{Binding Tab.IsCopy, Converter={StaticResource BoolToVisibility}}"
                      ToolTip="{Binding Screen.Localizer[websites.closeCopy]}" />
              <TextBlock Text="{Binding Tab.Status}"
                         Foreground="{DynamicResource Warning}"
                         FontSize="11"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding Tab.HasStatus, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentDim}" />
          <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource Accent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>

    <!-- The tabs, and the layout. A tab button puts the tab in the place
         last used; a speaker on it says it is playing sound. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The agent's own groups: made here, opened from the buttons beside the tabs. -->
          <Button Style="{StaticResource LayoutButton}"
                  Margin="0,0,12,0"
                  Content="{Binding Localizer[websites.groups]}"
                  Command="{Binding EditGroupsCommand}" />
          <Button x:Name="One" Style="{StaticResource LayoutButton}"
                  Content="{Binding Localizer[websites.layoutOne]}"
                  Command="{Binding SetLayoutCommand}" CommandParameter="1" />
          <Button x:Name="Two" Style="{StaticResource LayoutButton}"
                  Content="{Binding Localizer[websites.layoutTwo]}"
                  Command="{Binding SetLayoutCommand}" CommandParameter="2" />
          <Button x:Name="Four" Style="{StaticResource LayoutButton}"
                  Content="{Binding Localizer[websites.layoutFour]}"
                  Command="{Binding SetLayoutCommand}" CommandParameter="4" />
        </StackPanel>

        <!-- A group's button shows its tabs together (A-88). Before the tabs:
             a group is what an agent with four accounts reaches for. While its
             tabs are what is on screen it is marked, as the tab being shown,
             and a tab button replaces the whole group. -->
        <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding Groups}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:WebsiteGroupItem}">
              <Button Margin="0,0,6,4"
                      Content="{Binding Label}"
                      Command="{Binding DataContext.ShowGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsShown}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentDim}" />
                        <Setter Property="Foreground" Value="{DynamicResource Text}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:WebsiteTab}">
              <Button Style="{StaticResource SmallButton}"
                      Margin="0,0,6,4"
                      Command="{Binding DataContext.ShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SoundGlyph}"
                             FontFamily="{StaticResource Icons}"
                             FontSize="11"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsPlayingAudio}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsMutedByAgent}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Loading, no tabs, the server or the engine missing. -->
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding Message}"
               Style="{StaticResource Subtle}"
               Margin="16,16,16,0"
               TextWrapping="Wrap"
               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

    <!-- The four places: a bar row and a page row each, two by two. The
         browsers are put here in code, by row and column, and never moved
         out of this grid (see WebsiteTab). -->
    <Grid x:Name="Board" Background="{DynamicResource Bg}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition x:Name="BottomRow" Height="0" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
    </Grid>
  </DockPanel>
</UserControl>
