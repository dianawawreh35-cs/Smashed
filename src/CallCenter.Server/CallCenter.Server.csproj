<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CallCenter.Server</RootNamespace>
    <UserSecretsId>callcenter-server-5f3c1a02</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CallCenter.Shared\CallCenter.Shared.csproj" />
  </ItemGroup>

  <!-- Exposes the generated entry point to CallCenter.Server.Tests (WebApplicationFactory). -->
  <ItemGroup>
    <InternalsVisibleTo Include="CallCenter.Server.Tests" />
  </ItemGroup>


  <ItemGroup>
    <!-- The menu photographs, embedded so the seed is self-contained: a fresh
         install needs the one DLL and nothing beside it. 1.2 MB. -->
    <EmbeddedResource Include="Data\Seed\MenuImages\*.png" />

    <!-- The customer book carried over from the old ordering system, embedded
         for the same reason. 393 KB gzipped, 15,358 contacts. Regenerated from
         docs/Contacts.xlsx by tools/contacts-import/convert.py. -->
    <EmbeddedResource Include="Data\Seed\Contacts\contacts.csv.gz" />
  </ItemGroup>

</Project>
