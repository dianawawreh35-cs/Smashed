{
  "ConnectionStrings": {
    // 127.0.0.1 rather than "localhost", deliberately. On Windows
    // "localhost" resolves to the IPv6 ::1 first, and Docker Desktop
    // publishes Postgres on IPv4 only - so every *new* connection tried
    // IPv6, failed, and fell back. One at a time the pool hid it; a burst
    // of requests opened twenty connections at once and they timed out,
    // taking the menu pictures, the delivery search and the call log with
    // them. Production is unaffected: it already uses 127.0.0.1
    // (deploy/docker-compose.yml).
    "Default": "Host=127.0.0.1;Port=5432;Database=callcenter;Username=callcenter;Password=callcenter"
  },
  // Development-only values so `dotnet run` works without setting anything.
  // Production gets real secrets from the environment (runbook step 5).
  "Jwt": {
    "SigningKey": "dev-only-signing-key-not-for-production-0123456789"
  },
  "Security": {
    "SipSecretKey": "dev-only-sip-secret-key-not-for-production"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
