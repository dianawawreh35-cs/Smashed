{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=callcenter;Username=callcenter;Password=callcenter"
  },
  "Jwt": {
    // SigningKey is a deployment secret: set Jwt__SigningKey in the server
    // environment (runbook step 5). Blank here so an unconfigured server fails
    // at startup instead of signing tokens with a key that is in git.
    "SigningKey": "",
    "Issuer": "callcenter",
    "Audience": "callcenter",
    "Lifetime": "12:00:00"
  },
  "Security": {
    // Key for the SIP secrets in the users table (N-05). Set
    // Security__SipSecretKey in the server environment: openssl rand -base64 32
    "SipSecretKey": ""
  },
  "Sip": {
    // Fallback PBX address, used only while the pbx.host setting is still blank.
    "Server": ""
  },
  "MenuImages": {
    // Where the menu photographs (A-66) are kept. Deployed as /data/menu-images
    // beside the recordings, so runbook step 9 backs both up in one rsync.
    "Path": "data/menu-images"
  },
  "PosLookup": {
    // A-67: the restaurant POS's customer lookup, asked about recent unknown
    // callers. Token is a deployment secret: set PosLookup__Token in the server
    // environment (POS_LOOKUP_TOKEN in .env, runbook step 5), or
    // `dotnet user-secrets set PosLookup:Token ...` on a developer's machine.
    // Blank means the job never runs.
    "BaseUrl": "https://smashed-ps.com/api/CustLookup/",
    "Token": "",
    "Lookback": "2.00:00:00",
    "RetryAfter": "01:00:00",
    "MaxPerRun": 100
  },
  "Cors": {
    "DevOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/callcenter-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
